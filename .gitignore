# Sensitive — contains tokens and credentials
settings.json
settings.local.json
.credentials.json
.credentials.json.tmp*

# Plugin caches — re-downloaded on install
plugins/cache/
plugins/marketplaces/

# Local backups
backups/

# Session state files
sessions/

# ECC install state
ecc/

# Stale artifacts
.agents/files.zip

# Logs and temp
*.log
cache/

# IDE-specific
ide/

# Chrome extension data
chrome/

# History (large, local-only)
history.jsonl
file-history/

# Debug output
debug/

# Plans (session-specific)
plans/

# Homunculus
homunculus/

# Projects memory (per-machine)
projects/

# Paste cache (transient clipboard data)
paste-cache/

# Shell snapshots (session-specific)
shell-snapshots/

# Metrics (local telemetry)
metrics/

# Stats cache
stats-cache.json

# Plugin repos (large, cloned on install)
plugins/repos/

# Todos (session-specific)
todos/

# Statsig telemetry
statsig/

# Tasks (session-specific lock files)
tasks/

# Plugin config (regenerated)
plugins/blocklist.json
plugins/config.json
plugins/install-counts-cache.json
plugins/plugin-catalog-cache.json
plugins/.last_inuse_sweep

# Daemon runtime state (worker roster + local IPC key — never commit)
daemon/

# Background job/session runtime state (transient)
jobs/

# Telemetry (actual directory name; metrics/ above was stale)
telemetry/

# Scheduled task lock (the scheduled-tasks/ skill content itself is real, keep that)
scheduled_tasks.lock

# MCP server node_modules (regenerate via npm install)
mcp-servers/**/node_modules/

# Misc local state markers
.last-cleanup
.last-update-result.json
mcp-needs-auth-cache.json

# Personal backup files made during editing sessions
*.bak
