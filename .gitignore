# Sensitive — contains tokens and credentials
settings.json
settings.local.json
.credentials.json
.credentials.json.tmp*

# Plugin caches — re-downloaded on install
plugins/cache/
plugins/marketplaces/

# Local backups
backups/

# Session state files
sessions/

# ECC install state
ecc/

# Stale artifacts
.agents/files.zip

# Logs and temp
*.log
cache/

# IDE-specific
ide/

# Chrome extension data
chrome/

# History (large, local-only)
history.jsonl
file-history/

# Debug output
debug/

# Plans (session-specific)
plans/

# Homunculus
homunculus/

# Projects (per-machine session/transcript data) — EXCEPT each project's memory/
# subdirectory, which is durable cross-session learning and gets backed up centrally.
#
# Git can't re-include a path whose parent is excluded, and `projects/*` only
# matches ONE level deep — it does NOT recurse into re-included directories.
# A first attempt at this (2026-08-03) re-enabled traversal with `!projects/*/`
# but forgot to re-ignore what's directly inside each one, which put every
# session transcript sitting loose in a project directory (not just memory/)
# back in scope for the next `git add`. Caught before push; never landed on
# origin. The extra `projects/*/*` line below is what that fix was missing —
# it re-ignores one level further in, so ONLY the explicit memory/ negations
# after it survive.
projects/*
!projects/*/
projects/*/*
!projects/*/memory/
!projects/*/memory/**

# Paste cache (transient clipboard data)
paste-cache/

# Shell snapshots (session-specific)
shell-snapshots/

# Metrics (local telemetry)
metrics/

# Stats cache
stats-cache.json

# Plugin repos (large, cloned on install)
plugins/repos/

# Todos (session-specific)
todos/

# Statsig telemetry
statsig/

# Tasks (session-specific lock files)
tasks/

# Plugin config (regenerated)
plugins/blocklist.json
plugins/config.json
plugins/install-counts-cache.json
plugins/plugin-catalog-cache.json
plugins/.last_inuse_sweep

# Daemon runtime state (worker roster + local IPC key — never commit)
daemon/

# Background job/session runtime state (transient)
jobs/

# Telemetry (actual directory name; metrics/ above was stale)
telemetry/

# Scheduled task lock (the scheduled-tasks/ skill content itself is real, keep that)
scheduled_tasks.lock

# MCP server node_modules (regenerate via npm install)
mcp-servers/**/node_modules/

# Misc local state markers
.last-cleanup
.last-update-result.json
mcp-needs-auth-cache.json

# Personal backup files made during editing sessions
*.bak
